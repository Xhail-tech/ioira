<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ioira - Premium Wearables</title>
    <link rel="icon" href="logo.png" type="image/x-icon">
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div id="page-loader">
        <div class="loader-bar"></div>
    </div>

    <header>
        <div class="container">
            <div class="logo">
                <img src="logo.png" alt="ioira Logo">
            </div>
            <nav>
                <ul>
                    <li><a href="index.html" class="active">Home</a></li>
                    <li><a href="watches.html">Watches</a></li>
                    <li><a href="clothing.html">Clothing</a></li>
                    <li><a href="bracelets.html">Bracelets</a></li>
                    <li><a href="rings.html">Rings</a></li>
                    <li><a href="about.html">About</a></li>
                    <li><a href="contact.html">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <section class="hero">
        <div class="container">
            <h1>ioira</h1>
            <p>Elevate your everyday with premium wearables</p>
            <a href="#" class="btn-primary">Shop Collection</a>
        </div>
    </section>

    <section class="categories">
        <div class="container">
            <h2>Our Collections</h2>
            <div class="category-grid">
                <div class="category-card">
                    <div class="skeleton-loader">
                        <div class="skeleton-image"></div>
                        <div class="skeleton-text">
                            <div class="skeleton-line"></div>
                            <div class="skeleton-line"></div>
                        </div>
                    </div>
                    <h3>Watches</h3>
                    <p>Timeless precision crafted for modern life</p>
                    <a href="watches.html" class="btn-secondary">Explore →</a>
                </div>
                <div class="category-card">
                    <div class="skeleton-loader">
                        <div class="skeleton-image"></div>
                        <div class="skeleton-text">
                            <div class="skeleton-line"></div>
                            <div class="skeleton-line"></div>
                        </div>
                    </div>
                    <h3>Clothing</h3>
                    <p>Technical fabrics meets contemporary style</p>
                    <a href="clothing.html" class="btn-secondary">Explore →</a>
                </div>
                <div class="category-card">
                    <div class="skeleton-loader">
                        <div class="skeleton-image"></div>
                        <div class="skeleton-text">
                            <div class="skeleton-line"></div>
                            <div class="skeleton-line"></div>
                        </div>
                    </div>
                    <h3>Bracelets</h3>
                    <p>Subtle statements for every occasion</p>
                    <a href="bracelets.html" class="btn-secondary">Explore →</a>
                </div>
                <div class="category-card">
                    <div class="skeleton-loader">
                        <div class="skeleton-image"></div>
                        <div class="skeleton-text">
                            <div class="skeleton-line"></div>
                            <div class="skeleton-line"></div>
                        </div>
                    </div>
                    <h3>Rings</h3>
                    <p>Minimal designs with maximum impact</p>
                    <a href="rings.html" class="btn-secondary">Explore →</a>
                </div>
            </div>
        </div>
    </section>

    <section class="about">
        <div class="container">
            <div class="about-content">
                <h2>About ioir</h2>
                <p>ioira represents the intersection of timeless design and innovative technology. Our wearables are crafted for those who appreciate the finer details—where form meets function in perfect harmony.</p>
                <p>Each piece in our collection is thoughtfully designed to enhance your daily experience, blending premium materials with meticulous attention to detail. From our precision-engineered watches to our technically advanced clothing, every ioir product is created to elevate your personal style.</p>
                <a href="about.html" class="btn-primary">Learn More</a>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <img src="logo.png" alt="ioira Logo">
                </div>
                <div class="footer-links">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="index.html">Home</a></li>
                        <li><a href="watches.html">Watches</a></li>
                        <li><a href="clothing.html">Clothing</a></li>
                        <li><a href="bracelets.html">Bracelets</a></li>
                        <li><a href="rings.html">Rings</a></li>
                        <li><a href="about.html">About</a></li>
                        <li><a href="contact.html">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-contact">
                    <h4>Contact Us</h4>
                    <p>info@ioira.com</p>
                    <p>follow us:</p>
                    <div class="social-links">
                        <a href="#">Instagram</a>
                        <a href="#">Twitter</a>
                        <a href="#">Facebook</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 ioir. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // Page loader simulation
        window.addEventListener('load', function() {
            const loader = document.getElementById('page-loader');
            setTimeout(() => {
                loader.style.opacity = '0';
                setTimeout(() => {
                    loader.style.display = 'none';
                }, 300);
            }, 1500);
        });

        // Skeleton loader replacement with actual content after delay
        document.addEventListener('DOMContentLoaded', function() {
            const skeletons = document.querySelectorAll('.skeleton-loader');
            skeletons.forEach((skeleton, index) => {
                setTimeout(() => {
                    skeleton.innerHTML = `
                        <img src="logo.png" alt="Collection Preview" class="category-img">
                    `;
                }, 1000 + (index * 200));
            });
        });

        // Add interactivity - hover effects on cards
        document.querySelectorAll('.category-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px)';
                this.style.boxShadow = '0 10px 20px rgba(0,0,0,0.2)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
                this.style.boxShadow = '0 5px 15px rgba(0,0,0,0.1)';
            });
        });
    </script>
</body>
</html>